5 DEF FN MO(X) = X - INT(X/10)*10
10 REM LUHN ALGORITHM CREDIT CARD VALIDATOR
20 INPUT "ENTER CARD NUMBER"; N$
25 IF LEN(N$)=0 THEN PRINT "ERROR: CARD NUMBER REQUIRED" : END
30 L=LEN(N$)
40 S=0:A=1
50 REM PROCESS DIGITS RIGHT TO LEFT
60 FOR I=L TO 1 STEP -1
70 D=VAL(MID$(N$,I,1))
80 A=1-A
90 IF A=1 THEN D=D*2
100 IF D>9 THEN D=D-9
110 S=S+D
120 NEXT I
130 REM CHECK IF SUM IS DIVISIBLE BY 10
140 IF FN MO(S)=0 THEN PRINT "TRUE"
150 IF FN MO(S)<>0 THEN PRINT "FALSE"
